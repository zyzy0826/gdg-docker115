# ~/.bashrc for student @ gdg-server
# 小拿斯留下的 shell 設定。他說「這樣比較有 hacker 的感覺」。

# 非互動式 shell 直接跳出
case $- in
    *i*) ;;
      *) return;;
esac

HISTCONTROL=ignoreboth
HISTSIZE=2000
HISTFILESIZE=5000
shopt -s histappend
shopt -s checkwinsize

# --- 有顏色的提示字元 -------------------------------------------------------
#  綠色 使用者@主機 : 藍色 目前路徑 $
PS1='\[\e[1;32m\]\u@\h\[\e[0m\]:\[\e[1;34m\]\w\[\e[0m\]\$ '

# ls / grep 上色
alias ls='ls --color=auto'
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias grep='grep --color=auto'

# 小拿斯的懶人 alias（他真的很懶）
alias ..='cd ..'
alias ...='cd ../..'
alias c='clear'

# 大黃開帳號時順手加的任務指令
alias mission='/usr/local/bin/mission'
alias submit='/usr/local/bin/submit'

export EDITOR=nano
export PATH="$HOME/.local/bin:$PATH"

if [ -f /usr/share/bash-completion/bash_completion ]; then
    . /usr/share/bash-completion/bash_completion
fi

# --- 開場白 -----------------------------------------------------------------
if [ -z "${GDG_BANNER_SHOWN:-}" ]; then
export GDG_BANNER_SHOWN=1
cat <<'BANNER'

  ┌────────────────────────────────────────────────────────┐
  │  [INCOMING TRANSMISSION]                               │
  │  FROM: dahuang@external (第三屆社長・現職 SRE)         │
  │  TO:   student@gdg-server                              │
  │  ENCRYPTION: AES-256 (自己騙自己的，其實是明文)        │
  └────────────────────────────────────────────────────────┘

BANNER
echo ""
echo -e "\e[1;38;5;214m大黃\e[0m：我是大黃，第三屆社長。你不認識我沒關係。"
echo -e "\e[1;38;5;214m大黃\e[0m：這台伺服器被上一任社長小拿斯搞爛了，已經壞一年。"
echo -e "\e[1;38;5;214m大黃\e[0m：我每週三都會登入巡檢，看了一年，忍到極限了。"
echo -e "\e[1;38;5;214m大黃\e[0m：所以我幫你開了這個帳號。"
echo ""
echo -e "\e[1;31m[系統]\e[0m 官網狀態：\e[1;31mSYSTEM COMPROMISED\e[0m — 6 個安全節點離線"
echo ""
echo -e "  第一步：輸入 \e[1;36mcat ~/hint.txt\e[0m   讀任務簡報，裡面有第一個修復碼"
echo -e "  卡住時：輸入 \e[1;36mmission\e[0m          看進度和目前該做什麼"
echo -e "  交答案：輸入 \e[1;36msubmit GDG{...}\e[0m  提交找到的修復碼"
echo -e "  官網監控面板：\e[1;36mhttp://localhost:8080\e[0m"
echo ""
fi
